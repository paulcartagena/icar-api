# Copy to ~/icar/.env on the server and fill in. Never commit the real file.

# Public hostname: the Elastic IP with dashes + .sslip.io (e.g. 3-15-120-8.sslip.io), or your own domain
API_DOMAIN=

# RDS endpoint from the RDS console ("Connectivity & security")
PROD_URL_DB=jdbc:postgresql://<rds-endpoint>:5432/icar?sslmode=require
PROD_USERNAME_DB=icar
PROD_PASSWORD_DB=

# openssl rand -base64 48
JWT_SECRET=

# Admin created on first startup (password: 12 to 72 characters)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=

# Frontend origins allowed by CORS, comma-separated (add the production URLs when there are any)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Shared with the public website (icar-web's API_PROXY_SECRET) so the rate limits see each visitor's IP.
# openssl rand -base64 32
TRUSTED_PROXY_SECRET=

# true opens /scalar and /v3/api-docs (closed by default in production)
API_DOCS_ENABLED=false

# Online donations (developer.paypal.com > Apps & Credentials). Leave empty to keep them off (503).
# Sandbox first; for real payments use the Live app's credentials and https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
